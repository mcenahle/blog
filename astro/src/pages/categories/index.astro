---
import Base from '../../layouts/Base.astro';
import {posts,names} from '../../lib/posts';
const all=await posts();const groups=new Map<string,number>();for(const p of all)for(const name of names(p.data.categories))groups.set(name,(groups.get(name)||0)+1);
---
<Base title="分类"><h1 class="h2 mb-4">分类</h1><div class="d-flex flex-wrap gap-3">{[...groups].map(([name,count])=><a class="btn btn-outline-secondary" href={`/categories/${encodeURIComponent(name.replace(/\s+/g,'-'))}/`}>{name} <span class="badge text-bg-secondary">{count}</span></a>)}</div></Base>
