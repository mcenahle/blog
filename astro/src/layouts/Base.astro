---
import 'bootstrap/dist/css/bootstrap.min.css';
import '../styles/site.css';
import {ClientRouter} from 'astro:transitions';
import MusicPlayer from '../components/MusicPlayer.astro';
import Lightbox from '../components/Lightbox.astro';
const {title='梅之夏',description='Explore. Dream. Discover.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const structured={'@context':'https://schema.org','@type':'WebPage',name:title,description:description||'Explore. Dream. Discover.',url:canonical.href,inLanguage:'zh-CN',author:{'@type':'Person',name:'Mcenahle'}};
---
<!doctype html><html lang="zh-CN"><head><ClientRouter/><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} | 梅之夏</title><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={canonical}/><link rel="icon" href="/img/favicon.ico"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="author" content="Mcenahle"/><script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\u003c')}/><link rel="alternate" type="application/atom+xml" title="梅之夏 Atom" href="/feed.xml"/><link rel="alternate" type="application/rss+xml" title="梅之夏 RSS" href="/rss.xml"/>
<script is:inline>try{const p=localStorage.getItem('theme')||'auto';document.documentElement.dataset.bsTheme=p==='auto'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):p;}catch{}</script>
</head><body><a class="visually-hidden-focusable" href="#content">跳到正文</a><header class="border-bottom"><nav class="container py-3 d-flex flex-wrap align-items-center gap-3" aria-label="主导航"><a class="brand me-auto" href="/">梅之夏<span class="d-block small text-body-secondary">Explore. Dream. Discover.</span></a><a href="/">文章</a><a href="/archives/">归档</a><a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/search/">搜索</a><a href="/link/">友链</a><a href="/talks/">说说</a><a href="/cinema/">追剧</a><a href="/games/">游戏</a><a href="/musics/">音乐</a><a href="/charts/">统计</a><label class="small">外观 <select id="theme" class="form-select form-select-sm d-inline-block w-auto" aria-label="外观模式"><option value="auto">跟随系统</option><option value="light">浅色</option><option value="dark">深色</option></select></label></nav></header><main id="content" class="container py-5"><slot/></main><footer class="container border-top py-4 text-body-secondary small">© 2025–2026 Mcenahle · Astro 实验预览 · <a href="/rss.xml" data-astro-reload>RSS</a> · <a href="/feed.xml" data-astro-reload>Atom</a></footer>
<MusicPlayer/><Lightbox/><script src="../scripts/theme.ts"/></body></html>
