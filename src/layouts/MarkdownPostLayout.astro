---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

import ChatGPT from "../assets/ChatGPT.svg";

import Comments from "../layouts/Comments.astro";
const { frontmatter } = Astro.props;
---

<meta charset="utf-8" />
<Layout title={frontmatter.title}>
  <div class="mywords">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">首页</a></li>
        <li class="breadcrumb-item active" aria-current="page">
          {frontmatter.title}
        </li>
      </ol>
    </nav>

    <h2 style="font-size: 30px; margin-top: 30px;">
      {frontmatter.title}
    </h2>

    <div class="post-meta">
      <span>
        <Icon name="mdi:calendar" />
        发布于：{frontmatter.date}
      </span>
    </div>

    <!-- Example split danger button -->
    <div class="d-flex justify-content-end">
      <div class="btn-group">
        <a
          href="https://github.com/mcenahle/blog/"
          target="_blank"
          class="btn btn-primary"
          >查看 GitHub 源代码 <Icon name="mdi:open-in-new" /></a
        >
        <button
          type="button"
          class="btn btn-primary active dropdown-toggle dropdown-toggle-split"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <span class="visually-hidden">Toggle Dropdown</span>
        </button>
        <ul
          class="dropdown-menu m-0 border-0 shadow-sm p-2 dropdown-menu-end"
          data-bs-popper="none"
        >
          <li>
            <button class="dropdown-item px-3 py-2 rounded" id="ask-gpt">
              <ChatGPT /> 询问 ChatGPT <Icon name="mdi:open-in-new" /></button
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="posts" style="margin-top: 12px; margin-bottom: 30px;">
      <slot />
    </div>

    <a href="/" class="btn btn-outline-secondary" style="margin-bottom: 30px;">
      <Icon name="mdi:arrow-left" /> 返回首页</a
    >

    <Comments />
  </div>

  <script>
    document.querySelector("#ask-gpt")?.addEventListener("click", () => {
      const pageUrl = window.location.href;
      const prompt = `阅读 ${pageUrl}，然后回答这个问题：`;
      const url = `https://chatgpt.com/?prompt=${encodeURIComponent(prompt)}`;

      window.open(url, "_blank");
    });
  </script>

  <style is:global>
    .posts > .usa-table {
      font-family: "MN Source Han Serif SC", serif;
    }
  </style>
</Layout>
