---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";

const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true }),
).sort(
  (a: any, b: any) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime(),
);

import { Icon } from "astro-icon/components";

const title = "";
---

<Layout title={title}>
  <div class="mywords">
    <h2>梅之夏</h2>
    <div class="row gy-4">
      <div class="col-12 col-lg-8">
        <div class="list-group">
          {
            allPosts.map((post: any) => (
              <a href={post.url} class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                  <h5 class="mb-1">{post.frontmatter.title}</h5>
                  <small class="text-body-secondary">
                    {post.frontmatter.date}
                  </small>
                </div>
                <p class="mb-1">{post.frontmatter.description}</p>
              </a>
            ))
          }
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <div class="card">
          <div class="card-header">mcenahle</div>
          <div class="card-body">
            <h5 class="card-title">关于我</h5>
            <p class="card-text">
              一个喜欢计算机网络开发的 developer，但不想做程序员。
            </p>
            <div class="d-grid gap-1">
              <a
                href="https://github.com/mcenahle/"
                target="_blank"
                class="btn btn-primary"
                ><Icon name="mdi:github" /> 访问我的 GitHub</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
